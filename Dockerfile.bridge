# reachy-bridge: Reachy Mini SDK (WebRTC media) + MediaPipe + slot state machine.
# Build context is the repo root:  docker compose --profile reachy build reachy-bridge
# The Linux GStreamer/WebRTC stack is UNVERIFIED until Phase 0 spike M1 runs against a real robot
# (see reachy_bridge/README.md for the Windows-native fallback).
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MODELS_DIR=/bridge/models

# GStreamer + WebRTC (webrtcbin in plugins-bad, ICE in gstreamer1.0-nice), H.264/Opus decoders,
# GObject introspection typelibs, and the headers needed to pip-build PyGObject for this Python.
# libgl1/libglib2.0-0: mediapipe pulls in a full OpenCV build.
RUN apt-get update && apt-get install -y --no-install-recommends \
        gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-libav gstreamer1.0-nice \
        gir1.2-gstreamer-1.0 gir1.2-gst-plugins-base-1.0 gir1.2-gst-plugins-bad-1.0 gir1.2-glib-2.0 \
        libgirepository1.0-dev libcairo2-dev pkg-config gcc \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /bridge
COPY reachy_bridge/requirements.txt reachy_bridge/requirements.txt
# PyGObject >= 3.51 needs girepository-2.0, which bookworm does not ship.
RUN pip install "PyGObject<3.51" && pip install -r reachy_bridge/requirements.txt

COPY frontend_source/public/models/*.task /bridge/models/
COPY reachy_bridge /bridge/reachy_bridge

RUN useradd --create-home --uid 10001 bridge
USER bridge

CMD ["python", "-m", "reachy_bridge"]
